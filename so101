#!/usr/bin/env bash
# so101 - thin wrapper around the LeRobot CLI for an SO-101 leader/follower setup.
#
# Runs every command with the project venv (no activation needed) and fills in
# ports/ids/cameras from config/so101.env. Extra arguments are passed through
# to the underlying lerobot-* command, e.g.:
#   so101 record --dataset.num_episodes=20
set -euo pipefail

REPO_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
VENV_DIR="${VENV_DIR:-$REPO_DIR/.venv}"
CONFIG_FILE="${SO101_CONFIG:-$REPO_DIR/config/so101.env}"

CONFIG_VARS=(FOLLOWER_PORT LEADER_PORT FOLLOWER_ID LEADER_ID CAMERAS HF_USER
             DATASET_NAME TASK NUM_EPISODES EPISODE_TIME_S RESET_TIME_S PUSH_TO_HUB
             POLICY_TYPE POLICY_DEVICE WANDB_ENABLE)

# ---- load config (variables already set in the environment win) -------------
declare -A _override=()
for v in "${CONFIG_VARS[@]}"; do
    [[ -n "${!v+x}" ]] && _override[$v]="${!v}"
done
if [[ -f "$CONFIG_FILE" ]]; then
    # shellcheck disable=SC1090
    source "$CONFIG_FILE"
elif [[ -f "$REPO_DIR/config/so101.env.example" ]]; then
    # shellcheck disable=SC1091
    source "$REPO_DIR/config/so101.env.example"
fi
for v in "${!_override[@]}"; do printf -v "$v" '%s' "${_override[$v]}"; done
OUTPUTS_DIR="${OUTPUTS_DIR:-$REPO_DIR/outputs}"

# ---- use the venv ---------------------------------------------------------------
if [[ ! -x "$VENV_DIR/bin/python" ]]; then
    echo "Virtual environment not found at $VENV_DIR - run ./install.sh first." >&2
    exit 1
fi
export VIRTUAL_ENV="$VENV_DIR"
export PATH="$VENV_DIR/bin:$PATH"
unset PYTHONHOME

run() { echo "+ $*" >&2; "$@"; }

camera_args() { [[ -n "${CAMERAS:-}" ]] && printf '%s\n' "--robot.cameras=$CAMERAS"; return 0; }

hf_user() {
    if [[ -z "${HF_USER:-}" ]]; then
        HF_USER="$(NO_COLOR=1 hf auth whoami 2>/dev/null | awk -F': *' 'NR==1 {print $2}')"
        # older huggingface_hub prints just the name on the first line
        [[ -z "$HF_USER" ]] && HF_USER="$(NO_COLOR=1 hf auth whoami 2>/dev/null | head -n1)"
    fi
    if [[ -z "$HF_USER" || "$HF_USER" == *"Not logged in"* ]]; then
        echo "HF_USER unknown: run 'so101 hf-login' or set HF_USER in $CONFIG_FILE" >&2
        exit 1
    fi
    echo "$HF_USER"
}

follower_args() { printf '%s\n' --robot.type=so101_follower "--robot.port=$FOLLOWER_PORT" "--robot.id=$FOLLOWER_ID"; }
leader_args()   { printf '%s\n' --teleop.type=so101_leader "--teleop.port=$LEADER_PORT" "--teleop.id=$LEADER_ID"; }

usage() {
    cat <<EOF
so101 <command> [extra lerobot args]

Setup & diagnostics
  check                  Verify venv, CUDA/GPU, LeRobot, Feetech SDK, ffmpeg
  info                   lerobot-info (versions for bug reports)
  ports                  List serial devices
  find-port              lerobot-find-port (identify which port is which arm)
  bind-ports             Create stable /dev/so101_follower and /dev/so101_leader names
  find-cameras           lerobot-find-cameras opencv
  hf-login               Log in to the Hugging Face Hub (token with write access)
  shell                  Open a new shell with the venv activated

Motors & calibration
  setup-follower         lerobot-setup-motors for the follower arm (one-time)
  setup-leader           lerobot-setup-motors for the leader arm  (one-time)
  calibrate-follower     lerobot-calibrate for the follower arm
  calibrate-leader       lerobot-calibrate for the leader arm

Operation
  teleop                 Teleoperate follower with leader (adds cameras + rerun view if CAMERAS set)
  record                 Record a dataset into \$HF_USER/\$DATASET_NAME
  replay [EPISODE]       Replay an episode of \$HF_USER/\$DATASET_NAME on the follower (default 0)
  train                  Train \$POLICY_TYPE on \$HF_USER/\$DATASET_NAME (GPU)
  rollout POLICY_PATH    Run a trained policy on the follower (lerobot-rollout)
  run CMD [ARGS]         Run any command inside the venv (e.g. so101 run lerobot-eval --help)

Config: $CONFIG_FILE
Current: follower=$FOLLOWER_PORT ($FOLLOWER_ID)  leader=$LEADER_PORT ($LEADER_ID)
         cameras=${CAMERAS:-none}
EOF
}

cmd="${1:-help}"
[[ $# -gt 0 ]] && shift

case "$cmd" in
    help|-h|--help) usage ;;

    check)   run python "$REPO_DIR/scripts/check_env.py" ;;
    info)    run lerobot-info "$@" ;;
    ports)
        ls -l /dev/ttyACM* /dev/ttyUSB* /dev/so101_* 2>/dev/null || echo "No serial devices found."
        echo; ls -l /dev/serial/by-id/ 2>/dev/null || true ;;
    find-port)    run lerobot-find-port "$@" ;;
    bind-ports)   run bash "$REPO_DIR/scripts/bind_ports.sh" ;;
    find-cameras) run lerobot-find-cameras opencv "$@" ;;
    hf-login)     run hf auth login --add-to-git-credential "$@" ;;
    shell)
        echo "Starting a shell with the LeRobot venv active (type 'exit' to leave)."
        exec bash --rcfile <(echo "[ -f ~/.bashrc ] && source ~/.bashrc; source '$REPO_DIR/activate.sh'") -i ;;

    setup-follower)
        run lerobot-setup-motors --robot.type=so101_follower "--robot.port=$FOLLOWER_PORT" "$@" ;;
    setup-leader)
        run lerobot-setup-motors --teleop.type=so101_leader "--teleop.port=$LEADER_PORT" "$@" ;;
    calibrate-follower)
        mapfile -t F < <(follower_args)
        run lerobot-calibrate "${F[@]}" "$@" ;;
    calibrate-leader)
        mapfile -t L < <(leader_args)
        run lerobot-calibrate "${L[@]}" "$@" ;;

    teleop)
        mapfile -t F < <(follower_args); mapfile -t L < <(leader_args); mapfile -t C < <(camera_args)
        extra=()
        [[ ${#C[@]} -gt 0 ]] && extra=(--display_data=true)
        run lerobot-teleoperate "${F[@]}" "${C[@]}" "${L[@]}" "${extra[@]}" "$@" ;;

    record)
        user="$(hf_user)"
        mapfile -t F < <(follower_args); mapfile -t L < <(leader_args); mapfile -t C < <(camera_args)
        run lerobot-record "${F[@]}" "${C[@]}" "${L[@]}" \
            --display_data=true \
            "--dataset.repo_id=$user/$DATASET_NAME" \
            "--dataset.num_episodes=$NUM_EPISODES" \
            "--dataset.single_task=$TASK" \
            "--dataset.episode_time_s=$EPISODE_TIME_S" \
            "--dataset.reset_time_s=$RESET_TIME_S" \
            "--dataset.push_to_hub=$PUSH_TO_HUB" \
            "$@" ;;

    replay)
        episode=0
        if [[ $# -gt 0 && "$1" =~ ^[0-9]+$ ]]; then episode="$1"; shift; fi
        user="$(hf_user)"
        mapfile -t F < <(follower_args)
        run lerobot-replay "${F[@]}" "--dataset.repo_id=$user/$DATASET_NAME" "--dataset.episode=$episode" "$@" ;;

    train)
        user="$(hf_user)"
        name="${POLICY_TYPE}_${DATASET_NAME}"
        mkdir -p "$OUTPUTS_DIR/train"
        run lerobot-train \
            "--dataset.repo_id=$user/$DATASET_NAME" \
            "--policy.type=$POLICY_TYPE" \
            "--output_dir=$OUTPUTS_DIR/train/$name" \
            "--job_name=$name" \
            "--policy.device=$POLICY_DEVICE" \
            "--wandb.enable=$WANDB_ENABLE" \
            "--policy.repo_id=$user/$name" \
            "$@" ;;

    rollout)
        [[ $# -ge 1 ]] || { echo "usage: so101 rollout POLICY_PATH [args]  (hub id or local pretrained_model dir)" >&2; exit 1; }
        policy="$1"; shift
        mapfile -t F < <(follower_args); mapfile -t C < <(camera_args)
        run lerobot-rollout --strategy.type=base "--policy.path=$policy" \
            "${F[@]}" "${C[@]}" "--task=$TASK" --duration=60 "$@" ;;

    run)
        [[ $# -ge 1 ]] || { echo "usage: so101 run CMD [ARGS]" >&2; exit 1; }
        run "$@" ;;

    *) echo "Unknown command: $cmd" >&2; echo; usage; exit 1 ;;
esac
