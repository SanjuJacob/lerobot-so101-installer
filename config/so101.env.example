# SO-101 configuration used by the `so101` wrapper command.
# install.sh copies this file to config/so101.env (git-ignored) - edit that copy.
# Every value can also be overridden per command, e.g.:  FOLLOWER_PORT=/dev/ttyACM1 so101 teleop

# --- Serial ports --------------------------------------------------------------
# Find them with `so101 find-port`, or run `so101 bind-ports` once and use the
# stable names /dev/so101_follower and /dev/so101_leader.
FOLLOWER_PORT=/dev/ttyACM0
LEADER_PORT=/dev/ttyACM1

# --- Arm ids -----------------------------------------------------------------
# The id names the calibration file (~/.cache/huggingface/lerobot/calibration/).
# Always use the same id for the same physical arm.
FOLLOWER_ID=my_awesome_follower_arm
LEADER_ID=my_awesome_leader_arm

# --- Cameras ---------------------------------------------------------------------
# Leave empty for no cameras. Find indexes/paths with `so101 find-cameras`.
# Example with two cameras:
# CAMERAS="{ front: {type: opencv, index_or_path: /dev/video0, width: 640, height: 480, fps: 30}, wrist: {type: opencv, index_or_path: /dev/video2, width: 640, height: 480, fps: 30}}"
CAMERAS=""

# --- Hugging Face ----------------------------------------------------------------
# Leave empty to auto-detect from `hf auth whoami` (after `hf auth login`).
HF_USER=""

# --- Recording -----------------------------------------------------------------
DATASET_NAME=so101_test
TASK="Grab the black cube"
NUM_EPISODES=5
EPISODE_TIME_S=60
RESET_TIME_S=10
PUSH_TO_HUB=true

# --- Training ------------------------------------------------------------------
POLICY_TYPE=act
POLICY_DEVICE=cuda
WANDB_ENABLE=false
